# Collector API
COLLECTOR_URL=https://collector-dun.vercel.app
COLLECTOR_TOKEN=<read-only ingest key minted via POST /v1/api-keys>
COLLECTOR_ADMIN_TOKEN=<admin token set as COLLECTOR_ADMIN_TOKEN on the collector>

# Auth.js v5
AUTH_SECRET=<openssl rand -hex 32>

# Google OAuth — https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
AUTH_GOOGLE_ID=<google-client-id>
AUTH_GOOGLE_SECRET=<google-client-secret>

# Resend email magic links — https://resend.com
AUTH_RESEND_KEY=<resend-api-key>
AUTH_EMAIL_FROM=noreply@yourdomain.com
