# Local dev (SQLite). For prod, use a Neon pooled URL:
# postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# Comma-separated key:account_id pairs — seeded into the api_keys table on startup
COLLECTOR_API_KEYS=mykey123:my-account-id

# Optional LangGraph middleware demo sink settings.
# Use a writer key for the same account the portal reads.
LANGGRAPH_COLLECTOR_URL=http://localhost:8000
LANGGRAPH_COLLECTOR_API_KEY=mykey123
LANGGRAPH_AGENT_REF=coding_agent
LANGGRAPH_COLLECTOR_ONLY_PRICED=false

# Optional local client defaults for ./agent-langgraph-demo.
# This can be either the raw LangGraph base URL or the full Studio URL.
AGENT_LANGGRAPH_BASE_URL=
AGENT_LANGGRAPH_ASSISTANT=coding_agent

# Comma-separated origins allowed for CORS (dashboard URL etc.)
ALLOWED_ORIGINS=http://localhost:3000

PORT=8000
